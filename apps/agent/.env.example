# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://biagent:biagent@localhost/biagent

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Google OAuth (Sheets + Drive) ─────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Scopes needed: spreadsheets.readonly, drive.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:8000/v1/oauth/google-sheets/callback

# ── Google OAuth (Gmail) ──────────────────────────────────────────────────────
# Uses the same GCP client ID/secret above; separate redirect URI only.
# Scope: gmail.readonly
# WARNING: gmail.readonly is a sensitive scope — keep GCP project in Testing
# mode (max 100 users) until you complete Google's OAuth verification process.
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/v1/oauth/gmail/callback

# ── Security ──────────────────────────────────────────────────────────────────
# Exactly 32 characters — used for Fernet encryption of stored credentials.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32)[:32])"
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-32-char-secret!!

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# Your Clerk frontend API domain, e.g. clerk.your-domain.com
# Found at: Clerk Dashboard → API Keys → Advanced
CLERK_FRONTEND_API=

# ── Billing (Stripe) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ── Observability ─────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bi-agent-dev
# LANGCHAIN_TRACING_V2=true

# ── Embeddings (RAG) ───────────────────────────────────────────────────────────
# Anthropic sells no embedding model; Voyage is its recommended partner.
# Get a key: https://dash.voyageai.com
#
# Optional. Left empty, indexing and vector search are skipped and the retriever
# falls back to each provider's own search API — degraded, not broken. Only
# Gmail and Notion are indexed; spreadsheets go to DuckDB for exact aggregation.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-lite
# Cross-encoder that reranks the vector index's shortlist. Empty disables it and
# results keep their plain cosine ordering. Worth having: measurement showed the
# distance populations for "answered" and "not answered" questions overlap, so
# distance alone cannot decide when the index has nothing relevant.
RERANK_MODEL=rerank-2-lite

# ── n8n Automation ─────────────────────────────────────────────────────────────
# Traffic is inbound only: n8n calls the agent, never the reverse. The agent
# therefore reads no N8N_BASE_URL or N8N_API_KEY — the import script takes an
# API key from the shell (make import-workflows N8N_API_KEY=...).
#
# Both inbound routes — /v1/webhooks/n8n and /v1/schedules/run-due — are verified
# by an HMAC over the request body using this secret. /v1/schedules/run-due runs
# LLM work on behalf of arbitrary users, so keep it strong.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=change-me-webhook-secret

# ── MCP ──────────────────────────────────────────────────────────────────────
# Connectors are served as MCP tools by a FastMCP server (run: make mcp-server).
# The agent connects to it as an MCP client. OAuth still supplies per-user tokens.
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
# Shared secret the agent sends and the MCP server verifies. The MCP tools trust
# their user_id argument, so the server must only be reachable by the agent.
# Leave empty for local dev (unauthenticated); REQUIRED when APP_ENV=production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
MCP_SERVICE_SECRET=
