# Copy to .env.local and fill in. Never commit .env.local.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time —
# only ever put publishable/public values there. Everything else stays
# server-side and is readable only in route handlers and server components.

# ── Agent API ─────────────────────────────────────────────────────────────────
# Where the BFF proxy (src/app/api/agent/[...path]/route.ts) forwards requests.
# In Docker Compose this is the service name, not localhost.
AGENT_URL=http://localhost:8000

# ── Public app URL ────────────────────────────────────────────────────────────
# Used to build Stripe's success / cancel / portal-return URLs.
# Defaults to http://localhost:3000 when unset — which means a production
# deploy that forgets this sends paying users back to their own localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# Dashboard → API Keys. The publishable key is safe to expose; the secret key
# is used server-side by clerkMiddleware and auth() and must never be public.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Route configuration. These must match the actual page paths in src/app/,
# and the redirect targets must be routes clerkMiddleware protects.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# ── Billing (Stripe) ──────────────────────────────────────────────────────────
# Used by the two checkout/portal route handlers to create hosted sessions.
# Card details never reach this app — Stripe hosts the payment page.
STRIPE_SECRET_KEY=sk_test_...

# The recurring price the "Upgrade to Pro" button subscribes users to.
# Dashboard → Products → your Pro product → Pricing → copy the price ID.
STRIPE_PRO_PRICE_ID=price_...

# NOTE: STRIPE_WEBHOOK_SECRET is deliberately NOT here. Stripe webhooks are
# received by the agent, not this app — see apps/agent/.env.example. Likewise
# there is no NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: this app redirects to Stripe's
# hosted Checkout rather than mounting Stripe.js in the browser.
