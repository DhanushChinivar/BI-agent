{
  "name": "data_change_alert",
  "active": false,
  "nodes": [
    {
      "id": "cron-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "run-bi-query",
      "name": "Check Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_URL }}/v1/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-hub-signature-256",
              "value": "={{ 'sha256=' + $crypto.hmac($json.body, $env.WEBHOOK_SECRET, 'sha256', 'hex') }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: $vars.question, user_id: $vars.user_id, conversation_id: $vars.conversation_id }) }}"
      }
    },
    {
      "id": "check-changed",
      "name": "Has Answer Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.answer }}",
              "rightValue": "={{ $vars.last_answer }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "store-answer",
      "name": "Store Latest Answer",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [960, 200],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "last_answer",
              "value": "={{ $json.answer }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "no-change",
      "name": "No Change",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, 420],
      "parameters": {}
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Check Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Data": {
      "main": [
        [
          {
            "node": "Has Answer Changed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Answer Changed?": {
      "main": [
        [
          {
            "node": "Store Latest Answer",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Change",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
